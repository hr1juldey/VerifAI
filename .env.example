# ── I-JEPA Encoder ──────────────────────────────────────────────
IJEPA_MODEL_ID=facebook/ijepa_vith14_22k

# ── Verification ────────────────────────────────────────────────
VERIFICATION_THRESHOLD=0.7

# ── Spatial Diff ────────────────────────────────────────────────
SPATIAL_ALPHA=0.4
SPATIAL_DIFF_THRESHOLD=0.5

# ── Embedding Store ─────────────────────────────────────────────
EMBEDDINGS_PATH=data/embeddings.pt

# ── Ollama / Gemma Explainer ────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=ollama_chat/gemma4:e4b
OLLAMA_TEMPERATURE=0.3
OLLAMA_RETRIES=3

# ── Server ──────────────────────────────────────────────────────
GPU_CONCURRENCY=2
CORS_ORIGINS=*
